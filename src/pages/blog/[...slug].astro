---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const dateStr = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  author: { '@type': 'Person', name: SITE.name, url: SITE.url },
  keywords: d.tags.join(', '),
  mainEntityOfPage: new URL(`/blog/${entry.id}`, SITE.url).href,
};
---
<BaseLayout title={d.title} description={d.description} type="article" publishedTime={d.date} tags={d.tags} jsonLd={jsonLd}>
  <article class="section">
    <div class="container">
      <a href="/blog" class="back">← All writing</a>
      <header class="post-head" data-reveal>
        <div class="meta">
          <span class="cat">{d.category}</span>
          <time datetime={d.date.toISOString()}>{dateStr}</time>
          {d.readingTime && <span>· {d.readingTime}</span>}
        </div>
        <h1>{d.title}</h1>
        <p class="lede">{d.description}</p>
        {d.tags.length > 0 && <div class="tag-list">{d.tags.map((t) => <span class="tag">#{t}</span>)}</div>}
      </header>

      <div class="prose" data-reveal>
        <Content />
      </div>

      <div class="post-foot">
        <p>Written by <strong>{SITE.name}</strong> — {SITE.role}.</p>
        <div class="foot-actions">
          <a href="/blog" class="btn">More articles</a>
          <a href="/contact" class="btn btn-primary">Get in touch</a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .back { font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-dim); }
  .back:hover { color: var(--cyan); }
  .post-head { max-width: 760px; margin: 22px 0 36px; }
  .post-head .meta { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-faint); }
  .post-head .cat { color: var(--cyan); border: 1px solid var(--border); padding: 2px 10px; border-radius: 999px; }
  .post-head h1 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.1rem); margin: 16px 0; }
  .post-head .lede { font-size: 1.18rem; color: var(--text-dim); margin-bottom: 16px; }
  .post-foot { max-width: 760px; margin-top: 52px; padding-top: 28px; border-top: 1px solid var(--border); }
  .post-foot strong { color: var(--text); }
  .foot-actions { display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap; }
</style>
