---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE } from '../consts';

const projects = (await getCollection('projects', (p) => !p.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((p) => p.data.featured)
  .slice(0, 3);

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const stack = [
  { icon: '📱', group: 'App Development', items: ['Flutter', 'React Native', 'Android', 'REST/GraphQL APIs', 'Firebase'] },
  { icon: '🌐', group: 'Website Development', items: ['Astro', 'React', 'Next.js', 'TypeScript', 'Tailwind', 'Node.js'] },
  { icon: '🤖', group: 'Agentic AI', items: ['LLM agents', 'RAG', 'LangChain', 'Tool/Function calling', 'Workflow automation'] },
  { icon: '🧠', group: 'AI Infrastructure / MLOps', items: ['Python', 'MLflow', 'KServe', 'Model serving', 'GPU scheduling', 'Vector DBs'] },
  { icon: '⚙️', group: 'DevOps', items: ['Kubernetes', 'Docker', 'GitHub Actions', 'Argo CD', 'Terraform', 'Helm'] },
  { icon: '☁️', group: 'Cloud', items: ['AWS', 'Azure', 'GCP', 'EKS', 'Cloudflare', 'Prometheus', 'Grafana'] },
];

const certs = [
  { code: 'CKS', name: 'Certified Kubernetes Security Specialist', img: SITE.credlyImg.cks, local: '', file: SITE.credly.cks },
  { code: 'CKA', name: 'Certified Kubernetes Administrator', img: SITE.credlyImg.cka, local: '/Credentials/cka.png', file: SITE.credly.cka },
  { code: 'CKAD', name: 'Certified Kubernetes Application Developer', img: SITE.credlyImg.ckad, local: '/Credentials/ckad.png', file: SITE.credly.ckad },
  { code: 'KCNA', name: 'Kubernetes & Cloud Native Associate', img: SITE.credlyImg.kcna, local: '/Credentials/kcna.png', file: SITE.credly.kcna },
  { code: 'KCSA', name: 'Kubernetes & Cloud Native Security Associate', img: SITE.credlyImg.kcsa, local: '', file: SITE.credly.kcsa },
];
---

<BaseLayout showPersonSchema>
  <Hero />

  <!-- About strip -->
  <section id="about-strip" class="section section--tight">
    <div class="container about-strip" data-reveal>
      <p class="big-statement">
        One engineer for the <span class="gradient-text">whole stack</span> —
        apps, websites and agentic AI, running on cloud platforms that heal themselves.
        Available globally, freelance or full-time.
      </p>
      <a href="/about" class="link-arrow">More about me &amp; my journey →</a>
    </div>
  </section>

  <!-- Stack -->
  <section class="section" id="stack">
    <div class="container">
      <SectionHead eyebrow="Core skills" title="From idea to production — end to end" sub="I build the product and the platform it runs on: apps, websites and agentic AI on top of cloud-native DevOps and AI infrastructure." />
      <div class="grid cols-3 stack-grid">
        {stack.map((s, i) => (
          <div class="card stack-card" data-reveal data-delay={(i % 3) + 1}>
            <h3><span class="stk-icon" aria-hidden="true">{s.icon}</span>{s.group}</h3>
            <div class="tag-list">{s.items.map((it) => <span class="tag">{it}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="section" id="certs">
    <div class="container">
      <SectionHead eyebrow="Verified credentials" title="Kubestronaut &amp; the full Kubernetes suite" sub="All five core CNCF Kubernetes certifications — independently verifiable on Credly." />

      <a href={SITE.credly.kubestronaut} target="_blank" rel="noopener" class="card kube-banner" data-reveal aria-label="View Kubestronaut credential on Credly">
        <div class="kube-img">
          <img src={SITE.credlyImg.kubestronaut} alt="CNCF Kubestronaut official badge" class="badge-img kube-badge" width="180" height="180" loading="lazy"
               onerror="this.onerror=null;this.src='/Credentials/kubestronaut.webp';this.classList.remove('badge-img');" />
        </div>
        <div class="kube-text">
          <span class="eyebrow">CNCF Title</span>
          <h3>Kubestronaut</h3>
          <p>Awarded by the Cloud Native Computing Foundation for holding all five core Kubernetes certifications — CKS, CKA, CKAD, KCNA &amp; KCSA — simultaneously.</p>
          <span class="kube-verify">Verify on Credly →</span>
        </div>
      </a>

      <div class="grid certs-grid">
        {certs.map((c, i) => (
          <a href={c.file} target="_blank" rel="noopener" class="card cert" data-reveal data-delay={(i % 5) + 1} aria-label={`Verify ${c.code} on Credly`}>
            <img
              src={c.img}
              alt={`${c.name} (${c.code}) badge`}
              class="badge-img"
              width="92" height="92" loading="lazy"
              data-fallback={c.local}
              onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;this.dataset.fallback='';}else{this.style.display='none';this.parentElement.querySelector('.badge-fallback').style.display='grid';}"
            />
            <span class="badge-fallback" aria-hidden="true">{c.code}</span>
            <strong>{c.code}</strong>
            <span>{c.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="section" id="work">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow="Selected work" title="Engineering case studies" sub="Real systems, real trade-offs — architecture decisions, challenges and measurable outcomes." />
        <a href="/projects" class="btn btn-ghost see-all">All projects →</a>
      </div>
      <div class="grid cols-3">
        {projects.map((p, i) => (
          <ProjectCard
            href={`/projects/${p.id}`}
            title={p.data.title}
            summary={p.data.summary}
            stack={p.data.stack}
            domains={p.data.domains}
            impact={p.data.impact}
            delay={(i % 3) + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- GitHub activity -->
  <section class="section" id="github">
    <div class="container">
      <SectionHead eyebrow="Engineering presence" title="Building in the open" sub="Live activity from my GitHub — labs, infrastructure code and contributions." />
      <div class="gh card" data-reveal>
        <div class="gh-text">
          <h3>@{SITE.githubUser}</h3>
          <p>Infrastructure code, Kubernetes labs, automation scripts and project source. Follow along or collaborate.</p>
          <a href={SITE.socials.github} target="_blank" rel="noopener" class="btn btn-primary">View GitHub profile</a>
        </div>
        <div class="gh-graph">
          <img src={`https://ghchart.rshah.org/2dd4bf/${SITE.githubUser}`} alt={`GitHub contribution graph for ${SITE.githubUser}`} loading="lazy" width="663" height="104" />
          <div class="gh-stats">
            <img src={`https://github-readme-stats.vercel.app/api?username=${SITE.githubUser}&hide_title=true&hide_border=true&bg_color=00000000&text_color=9fb0c6&icon_color=2dd4bf&title_color=2dd4bf&show_icons=true`} alt="GitHub statistics" loading="lazy" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest writing -->
  <section class="section" id="writing">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow="Technical writing" title="From the blog" sub="Deep dives and guides on Kubernetes, GitOps, observability and AI infrastructure." />
        <a href="/blog" class="btn btn-ghost see-all">All articles →</a>
      </div>
      <div class="grid cols-3">
        {posts.map((p, i) => (
          <ArticleCard
            href={`/blog/${p.id}`}
            title={p.data.title}
            description={p.data.description}
            date={p.data.date}
            category={p.data.category}
            readingTime={p.data.readingTime}
            tags={p.data.tags}
            delay={(i % 3) + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="section" id="cta">
    <div class="container">
      <div class="cta-banner" data-reveal>
        <h2>Let's build something <span class="gradient-text">great</span>.</h2>
        <p>Whether it's an app, a website, an agentic AI workflow, or the DevOps / MLOps platform behind it — I'm available worldwide for freelance, full-time remote, or project-based work.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Start a conversation</a>
          <a href={`mailto:${SITE.email}`} class="btn">{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-strip { display: flex; flex-direction: column; gap: 18px; }
  .big-statement { font-family: var(--font-display); font-size: clamp(1.5rem, 1rem + 2.4vw, 2.5rem); line-height: 1.25; color: var(--text); max-width: 22ch; letter-spacing: -0.02em; }
  @media (min-width: 760px) { .big-statement { max-width: 28ch; } }
  .link-arrow { color: var(--cyan); font-family: var(--font-display); width: fit-content; }
  .head-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .head-row .section-head { margin-bottom: 28px; }
  .see-all { white-space: nowrap; margin-bottom: 28px; }

  .stack-card h3 { font-size: 1.05rem; margin-bottom: 14px; color: var(--text); display: flex; align-items: center; gap: 10px; }
  .stk-icon { font-size: 1.3rem; }

  .kube-banner { display: grid; grid-template-columns: 200px 1fr; gap: 28px; align-items: center; margin-bottom: 24px; padding: clamp(20px, 3vw, 32px); }
  .kube-img { display: grid; place-items: center; }
  .kube-img img { width: 100%; max-width: 180px; }
  .kube-badge { height: auto; object-fit: contain; filter: drop-shadow(0 8px 22px rgba(45,212,191,0.35)); }
  .kube-text h3 { font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem); margin: 12px 0 10px; background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .kube-text p { max-width: 60ch; }
  .kube-verify { display: inline-block; margin-top: 14px; color: var(--cyan); font-family: var(--font-display); transition: letter-spacing 0.3s; }
  .kube-banner:hover .kube-verify { letter-spacing: 0.03em; }

  .certs-grid { grid-template-columns: repeat(5, 1fr); }
  @media (max-width: 980px) { .certs-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px) { .kube-banner { grid-template-columns: 1fr; justify-items: center; text-align: center; } .kube-text p { margin-inline: auto; } }
  @media (max-width: 560px) { .certs-grid { grid-template-columns: repeat(2, 1fr); } }

  .cert { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; }
  .badge-img { width: 92px; height: 92px; object-fit: contain; filter: drop-shadow(0 6px 16px rgba(0,0,0,0.45)); transition: transform 0.35s var(--ease); }
  .cert:hover .badge-img { transform: scale(1.06) translateY(-2px); }
  .badge-fallback { display: none; width: 84px; height: 84px; place-items: center; border-radius: 16px; font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; color: #04121a; background: var(--grad-brand); box-shadow: var(--glow-cyan); }
  .cert strong { font-family: var(--font-display); font-size: 1.15rem; color: var(--cyan); margin-top: 4px; }
  .cert span { font-size: 0.8rem; color: var(--text-faint); line-height: 1.4; }

  .gh { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 32px; align-items: center; }
  .gh-text h3 { font-family: var(--font-mono); color: var(--cyan); }
  .gh-text p { margin: 12px 0 20px; }
  .gh-graph { display: flex; flex-direction: column; gap: 16px; }
  .gh-graph img { width: 100%; border-radius: 8px; }
  @media (max-width: 820px) { .gh { grid-template-columns: 1fr; } }

  .cta-banner { text-align: center; padding: clamp(40px, 6vw, 72px); border-radius: var(--radius-lg); border: 1px solid var(--border-strong); background: radial-gradient(120% 140% at 50% 0%, rgba(45,212,191,0.12), transparent 60%), var(--surface); }
  .cta-banner p { max-width: 52ch; margin: 16px auto 28px; }
  .cta-actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
</style>
