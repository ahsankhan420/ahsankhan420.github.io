---
import { SITE, FOOTER_GROUPS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand"><span class="brand-mark" aria-hidden="true"></span>{SITE.brand.primary}<span>{SITE.brand.accent}</span></a>
        <p>{SITE.tagline}</p>
        <p class="footer-name">{SITE.name} <span>· {SITE.altName}</span></p>
        <div class="footer-socials">
          <a href={SITE.socials.github} target="_blank" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.3-.5-1.5.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 5 18 5.3 18 5.3c.7 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z"/></svg></a>
          <a href={SITE.socials.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.4 20.4h-3.5v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9v5.7H9.4V9h3.3v1.6h.1c.5-.9 1.6-1.9 3.3-1.9 3.5 0 4.2 2.3 4.2 5.4v6.3ZM5.3 7.4a2 2 0 1 1 0-4.1 2 2 0 0 1 0 4.1ZM7.1 20.4H3.6V9h3.5v11.4ZM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0Z"/></svg></a>
          <a href={SITE.socials.twitter} target="_blank" rel="noopener" aria-label="X / Twitter"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.9 1.2h3.6l-7.9 9 9.3 12.3h-7.3l-5.7-7.5-6.6 7.5H.7l8.5-9.7L0 1.2h7.5l5.1 6.8 6.3-6.8Zm-1.3 19.5h2L6.5 3.3h-2.1l13.2 17.4Z"/></svg></a>
          <a href="/rss.xml" aria-label="RSS feed"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9h2.5A11.5 11.5 0 0 0 4 8.5V11Zm0 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0-10a15 15 0 0 1 15 15h2.5A17.5 17.5 0 0 0 4 3.5V6Z"/></svg></a>
        </div>
      </div>

      {FOOTER_GROUPS.map((g) => (
        <nav class="footer-col" aria-label={g.title}>
          <h3>{g.title}</h3>
          <ul>
            {g.links.map((l) => (
              <li><a href={l.href} {...(('external' in l && l.external) ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}

      <div class="footer-col footer-cta">
        <h3>Open to opportunities</h3>
        <p>Apps, websites, agentic AI & cloud platforms — freelance, remote or project, worldwide.</p>
        <a href="/contact" class="btn btn-primary">Get in touch</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {SITE.name}. Built with Astro · deployed on GitHub Pages.</p>
      <p class="footer-status"><span class="dot" aria-hidden="true"></span> Available for work</p>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); margin-top: 80px; padding-block: 64px 28px; background: linear-gradient(180deg, transparent, rgba(99,102,241,0.04)); }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1.2fr; gap: 40px; }
  .brand { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; display: inline-flex; align-items: center; gap: 10px; }
  .brand span { color: var(--cyan); }
  .brand-mark { width: 18px; height: 18px; border-radius: 6px; background: var(--grad-brand); }
  .footer-brand p { margin-top: 14px; max-width: 36ch; }
  .footer-name { color: var(--text); font-family: var(--font-mono); font-size: 0.85rem; }
  .footer-name span { color: var(--text-faint); }
  .footer-socials { display: flex; gap: 12px; margin-top: 18px; }
  .footer-socials a { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 10px; border: 1px solid var(--border); color: var(--text-dim); transition: all 0.25s; }
  .footer-socials a:hover { color: var(--cyan); border-color: var(--cyan); transform: translateY(-2px); }
  .footer-col h3 { font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 14px; font-family: var(--font-mono); }
  .footer-col ul { list-style: none; display: grid; gap: 10px; }
  .footer-col a { color: var(--text-dim); transition: color 0.2s; }
  .footer-col a:hover { color: var(--cyan); }
  .footer-cta p { margin-bottom: 16px; }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); }
  .footer-bottom p { font-size: 0.85rem; color: var(--text-faint); }
  .footer-status { display: inline-flex; align-items: center; gap: 8px; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #34d399; box-shadow: 0 0 10px #34d399; }
  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
